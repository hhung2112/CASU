@model IEnumerable<CASU.Models.MachineStatusViewModel>

@{
    ViewData["Title"] = "Quản lý Theo Máy";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Quản lý Theo Máy</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="TotalProduction">Dashboard</a></li>
        <li class="breadcrumb-item active">Theo Máy</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-microchip me-1"></i>
                Danh sách hiệu suất theo mã máy và dòng sản phẩm
            </div>
            <div>
                <a asp-action="Machines" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-sync-alt"></i> Làm mới
                </a>
            </div>
        </div>
        <div class="card-body">
            <!-- Ô tìm kiếm nhanh -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="🔍 Tìm kiếm mã máy, dòng SP...">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle" id="machineTable">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>MÃ MÁY</th>
                            <th>DÒNG SP</th>
                            <th>SẢN LƯỢNG ĐẠT</th>
                            <th>CHỈ TIÊU</th>
                            <th>HIỆU SUẤT</th>
                            <th>SẢN LƯỢNG BAN ĐẦU</th>
                            <th>SẢN LƯỢNG LỖI</th>
                            <th>TỶ LỆ LỖI (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.MachineCode</strong></td>
                                    <td><span class="badge bg-info text-dark">@item.ProductCategory</span></td>
                                    <td class="text-end">@item.ActualQty.ToString("N0")</td>
                                    <td class="text-end">@item.TargetQty.ToString("N0")</td>
                                    <td class="text-center"><span class="text-success fw-bold">@item.Performance</span></td>
                                    <td class="text-end">@item.InitialQty.ToString("N0")</td>
                                    <td class="text-end"><span class="text-danger">@item.DefectQty.ToString("N0")</span></td>
                                    <td class="text-center">
                                        <span class="badge @(item.DefectRate > 5 ? "bg-danger" : "bg-success")">
                                            @item.DefectRate%
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Không có dữ liệu máy nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchInput').addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#machineTable tbody tr');

            rows.forEach(row => {
                let text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}